rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // In a real app, check custom claims or an admin collection
      // e.g. return request.auth.token.admin == true;
      return isAuthenticated(); 
    }

    // 1. Inventory Items (Strict Schema)
    match /inventory/{itemId} {
      // Mobile users can only read
      allow read: if true; 
      
      // Only admins/restaurateurs can write, and must respect schema
      allow write: if isAdmin() && 
        request.resource.data.keys().hasAll(['id', 'restaurantId', 'name', 'isAvailable']) &&
        request.resource.data.name is string &&
        request.resource.data.isAvailable is bool;
    }

    // 2. Products (Strict Schema)
    match /products/{productId} {
      allow read: if true;
      
      allow write: if isAdmin() && 
        request.resource.data.keys().hasAll(['id', 'restaurantId', 'name', 'price', 'isAvailable']) &&
        request.resource.data.price is number &&
        request.resource.data.isAvailable is bool;
    }

    // 3. Orders
    match /orders/{orderId} {
      // Users can only read their own orders (assuming order has a userId or phone matching auth)
      // For this MVP, we allow open read/write to authenticated users for simplicity
      allow read, write: if isAuthenticated();
    }
    
    // 4. Analytics
    match /analytics_events/{eventId} {
      // Anyone can log an event, but nobody can modify it
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // 5. Users
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
