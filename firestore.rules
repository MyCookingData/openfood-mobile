rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & RBAC SECURITY (AUDITÉ COOKING DATA)
    // =========================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        (hasUserDoc() && getUserData().role == 'admin')
      );
    }
    
    function isRestaurateur(restaurantId) {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'restaurateur' ||
        (hasUserDoc() && getUserData().role == 'restaurateur' && (getUserData().restaurantId == restaurantId || getUserData().restoId == restaurantId))
      );
    }
    
    function isLivreur() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'livreur' ||
        (hasUserDoc() && getUserData().role == 'livreur')
      );
    }

    // =========================================================================
    // 1. RESTAURANTS
    // =========================================================================
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if isRestaurateur(restaurantId) || isAdmin();
    }

    // =========================================================================
    // 2. PRODUCTS (PLATS & MENUS)
    // =========================================================================
    match /products/{productId} {
      allow read: if true;
      allow create, update: if (
        isRestaurateur(request.resource.data.restaurantId) || isAdmin()
      ) && request.resource.data.keys().hasAll(['name', 'price', 'restaurantId', 'isAvailable']);
      allow delete: if isAdmin() || (
        resource != null && isRestaurateur(resource.data.restaurantId)
      );
    }

    // =========================================================================
    // 3. INVENTORY (STOCKS & DISPONIBILITÉS)
    // =========================================================================
    match /inventory/{itemId} {
      allow read: if true;
      allow write: if (
        isAdmin() ||
        (resource != null && isRestaurateur(resource.data.restaurantId)) ||
        (request.resource != null && isRestaurateur(request.resource.data.restaurantId))
      );
    }

    // =========================================================================
    // 4. COMMANDES (/orders) - ISOLATION STRICTE
    // =========================================================================
    match /orders/{orderId} {
      // Lecture : Le client propriétaire, le restaurateur concerné, le livreur assigné ou l'admin
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.livreurId == request.auth.uid ||
        isRestaurateur(resource.data.restaurantId) ||
        (isLivreur() && resource.data.status in [1, 2, 3]) // Permet aux livreurs de voir les courses disponibles
      );
      
      // Création : Un client authentifié créant sa propre commande
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Mise à jour : Contrôle par statut et rôle
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isRestaurateur(resource.data.restaurantId) ||
        (isLivreur() && (resource.data.livreurId == request.auth.uid || resource.data.status in [1, 2])) ||
        (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancellationReason', 'isCancelledByCustomer']))
      );
      
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 5. PROMOTIONS & CARROUSELS
    // =========================================================================
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /carousels/{carouselId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 6. ANALYTICS & TÉLÉMÉTRIE
    // =========================================================================
    match /analytics_events/{eventId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // 7. UTILISATEURS (/users)
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == userId && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'customClaims'])
        ))
      );
      allow delete: if isAdmin();
    }
  }
}
